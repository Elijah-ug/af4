generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id         Int       @id @default(autoincrement())
  name       String
  username   String?   @unique
  email      String    @unique
  role       String    @default("ordinary")
  password   String
  profilePic String?
  location   String?
  status     String    @default("inactive")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  verifiedAt DateTime?
  isDeleted  Boolean   @default(false)
  deletedAt  DateTime?
  updates    Update[]
}

model User {
  id               Int           @id @default(autoincrement())
  name             String
  username         String?       @unique
  email            String        @unique
  password         String
  gender           String
  dateOfBirth      String
  age              Int?
  bio              String?
  profilePic       String?
  galary           UserPic[]
  location         String?
  interests        String[] // Prisma supports arrays in Postgres
  likes            Int?
  status           String        @default("inactive")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  verifiedAt       DateTime?
  posts            UserPost[]
  sentMessages     Message[]     @relation("SentMessages")
  receivedMessages Message[]     @relation("ReceivedMessages")
  userQueries      UserQueries[]
  isDeleted        Boolean       @default(false)
  deletedAt        DateTime?
  friend           Penpal[]      @relation("friend")
  user             Penpal[]      @relation("user")
  likesFrom        Like[]        @relation("from")
  likesTo          Like[]        @relation("to")
  matchesA         Match[]       @relation("userA")
  matchesB         Match[]       @relation("userB")
}

model Update {
  id        Int       @id @default(autoincrement())
  tag       String
  info      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  admin     Admin     @relation(fields: [adminId], references: [id])
  adminId   Int
}

model UserPic {
  id         Int      @id @default(autoincrement())
  url        String
  likes      Int?
  isPrimary  Boolean  @default(false)
  uploadedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
  userId     Int
}

model UserPost {
  id        Int       @id @default(autoincrement())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tag       String
  info      String
  user      User      @relation(fields: [userId], references: [id])
  userId    Int
  likes     Int?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
}

model Message {
  id                Int       @id @default(autoincrement())
  content           String
  sender            User      @relation("SentMessages", fields: [senderId], references: [id])
  senderId          Int
  receiver          User      @relation("ReceivedMessages", fields: [receiverId], references: [id])
  receiverId        Int
  penpalId          Int
  penpal            Penpal    @relation(fields: [penpalId], references: [id])
  createdAt         DateTime? @default(now())
  readAt            DateTime?
  updatedAt         DateTime?
  deletedAt         DateTime?
  senderDeletedAt   DateTime?
  receiverDeletedAt DateTime?
}

model Penpal {
  id        Int       @id @default(autoincrement())
  friendId  Int
  userId    Int
  user      User      @relation("user", fields: [userId], references: [id])
  friend    User      @relation("friend", fields: [friendId], references: [id])
  message   Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime?
  readAt    DateTime?

  @@unique([userId, friendId])
}

model Like {
  id        Int       @id @default(autoincrement())
  fromUser  Int
  toUser    Int
  userA     User      @relation("from", fields: [fromUser], references: [id])
  userB     User      @relation("to", fields: [toUser], references: [id])
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@unique([fromUser, toUser])
}

model Match {
  id        Int       @id @default(autoincrement())
  userAId   Int
  userBId   Int
  userA     User      @relation("userA", fields: [userAId], references: [id])
  userB     User      @relation("userB", fields: [userBId], references: [id])
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@unique([userAId, userBId])
}

model UserQueries {
  id        Int       @id @default(autoincrement())
  name      String?
  email     String
  subject   String?
  message   String
  sender    User      @relation(fields: [senderId], references: [id])
  senderId  Int
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
}
