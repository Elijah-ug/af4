generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id         Int       @id @default(autoincrement())
  name       String?
  username   String    @unique
  email      String    @unique
  password   String
  bio        String?
  profilePic String?
  location   String?
  status     String    @default("inactive")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  verifiedAt DateTime?
  users      User[]
  updates    Update[]
}

model User {
  id          Int        @id @default(autoincrement())
  name        String?
  username    String     @unique
  email       String     @unique
  password    String
  gender      String?
  dateOfBirth DateTime?
  bio         String?
  profilePic  String?
  galary      UserPic[]
  location    String?
  interests   String[] // Prisma supports arrays in Postgres
  status      String     @default("inactive")
  admin       Admin      @relation(fields: [adminId], references: [id])
  adminId     Int
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  verifiedAt  DateTime?
  posts       UserPost[]
}

model Update {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tag       String
  info      String
  admin     Admin    @relation(fields: [adminId], references: [id])
  adminId   Int
}

model UserPic {
  id         Int      @id @default(autoincrement())
  url        String
  isPrimary  Boolean  @default(false)
  uploadedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
  userId     Int
}

model UserPost {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tag       String
  info      String
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
}
